@model IList<Attendance.Web.Models.ViewModels.Person.PersonViewModel>
@{
    ViewBag.Title = "Persons";
}

<h2>Persons</h2>
<p>
    @Html.ActionLink("Create new person", "Create")
</p>
<table class="table">
    <tr>
        <th>First name</th>
        <th>Last name</th>
        <th></th>
    </tr>
    @foreach(var p in Model)
    {
        <tr>
            <td>@p.FirstName</td>
            <td>@p.LastName</td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = p.PersonId })
            </td>
        </tr>
    }
</table>
